NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/events_db?schema=public"
JWT_ACCESS_SECRET=access-token-super-secret-key-32bytes-min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=refresh-token-super-secret-key-32bytes-min
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=*
THROTTLE_TTL=60
THROTTLE_LIMIT=100
